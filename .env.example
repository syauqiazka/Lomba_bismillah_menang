# Neon PostgreSQL Connection URLs
DATABASE_URL="postgresql://neondb_owner:npg_sample@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_sample@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session Security Secret (iron-session)
# WAJIB diisi pada environment production (minimal 32 karakter acak).
# Contoh pembuatan secret aman di terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   atau: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Node Environment (development | production | test)
NODE_ENV="development"

# Opsional Tingkat 2: Kunci API AI (hanya digunakan di server action)
# AI_API_KEY=""
